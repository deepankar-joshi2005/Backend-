# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp notifications (Meta WhatsApp Cloud API)
# Copy these into your real .env. Nothing is sent on WhatsApp until
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID are filled in — the moment
# they are (and at least WHATSAPP_TEMPLATE_GENERIC is approved), every event
# starts going out on WhatsApp automatically. See docs/WHATSAPP_SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# Meta App → WhatsApp → API Setup. Use a *permanent* System User token in production.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — for your reference only (not used for sending).
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Prefixed to 10-digit mobile numbers stored without a country code.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Language code your templates were approved in (e.g. en, en_US, hi).
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to "false" to switch WhatsApp off without removing the keys.
WHATSAPP_ENABLED=true

# Webhook (delivery status + automatic opt-out when someone replies STOP).
# Meta App → WhatsApp → Configuration → Callback URL:
#   https://<your-backend-domain>/api/v1/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=

# ── Message templates ──
# ONE generic template is enough to switch WhatsApp on for every event:
#   body: "Hello {{1}},\n\n{{2}}\n\n— {{3}}"   ({{1}} name, {{2}} message, {{3}} sender)
WHATSAPP_TEMPLATE_GENERIC=
# Optional: a dedicated template per event (overrides the generic one for that
# event). Set any of them to "off" to stop WhatsApp for just that event.
# Parameter order for each is listed in docs/WHATSAPP_SETUP.md.
WHATSAPP_TEMPLATE_COMPLIANCE_DEADLINE_REMINDER=
WHATSAPP_TEMPLATE_COMPLIANCE_TASK_COMPLETED=
WHATSAPP_TEMPLATE_CRM_FOLLOWUP_REMINDER=
WHATSAPP_TEMPLATE_CRM_CLIENT_CONVERTED=
WHATSAPP_TEMPLATE_FINANCE_REPORT_SHARED=
WHATSAPP_TEMPLATE_BUSINESS_CLIENT_INVITE=
WHATSAPP_TEMPLATE_USER_ACCOUNT_CREATED=
WHATSAPP_TEMPLATE_HRMS_LEAVE_STATUS=
WHATSAPP_TEMPLATE_HRMS_LEAVE_APPLIED=
WHATSAPP_TEMPLATE_HRMS_ATTENDANCE_REQUEST_STATUS=
WHATSAPP_TEMPLATE_HRMS_SHIFT_ASSIGNED=
WHATSAPP_TEMPLATE_HRMS_PAYSLIP_GENERATED=
WHATSAPP_TEMPLATE_HRMS_RESIGNATION_STATUS=
WHATSAPP_TEMPLATE_HRMS_LETTER_ISSUED=
WHATSAPP_TEMPLATE_HRMS_REQUEST_STATUS=

# ── Reminder scheduler (Compliance deadlines + CRM follow-ups) ──
NOTIFICATION_JOBS_ENABLED=true
# Cron in IST. Default: hourly 9am–8pm (each reminder is still sent only once).
NOTIFICATION_CRON=0 9-20 * * *
# Days before a compliance due date to remind the client (and the assigned staff).
COMPLIANCE_REMINDER_DAYS=7,3,1,0

# ── HRMS email branding ──
# HRMS emails are branded with the recipient's own company name automatically;
# this is only the fallback when no company can be found for the address.
HRMS_BRAND_NAME=HRMS
